      "David Feige",
      "Sonay Hoffman",
      "Kerry Orent"
     ],
     "content_rating": "TV-14",
     "release_country": [
      "United States"
     ],
     "filming_location": "Sing Sing Penitentiary - 354 Hunter Street, Ossining, New York, USA, New York City, New York, USA",
     "audience_identity": null,
     "genre_description": "A hybrid of crime drama and legal drama with strong thriller elements; it combines serialized courtroom storytelling and case-focused procedural sequences. As a prison drama and courtroom drama, it foregrounds legal strategy, investigative work, and moral conflict, while using suspenseful, high-stakes scenarios typical of thrillers.",
     "style_description": "Gritty and realistic in visual approach, favoring intimate, character-focused camerawork, naturalistic performances, and stark production design to evoke the claustrophobia of incarceration. The show balances procedural pacing in courtroom scenes with emotionally charged, dramatic beats; the score and editing heighten tension without melodrama, keeping the storytelling grounded and urgent.",
     "production_companies": [
      "Doug Robinson Productions",
      "Channel Road Productions",
      "G-Unit Film & Television",
      "ABC Signature",
      "Sony Pictures Television Studios",
      "Amazon Freevee",
      "American Broadcasting Company (ABC)",
      "D-Smart Go",
      "Disney+",
      "Disney+",
      "Netflix",
      "Paramount+",
      "Walt Disney Television",
      "Brauer & Co.",
      "Stellular Pictures"
     ],
     "situational_contexts": null,
     "influenced_other_media": null,
     "plot_themes_description": "The series centers on themes of justice and redemption, focusing on wrongful conviction, institutional corruption, and the struggle to reclaim agency within a broken system. It also examines loyalty and sacrifice among family and inmates, the ethics of legal advocacy, and the long-term emotional and social consequences of incarceration.",
     "emotional_tone_description": "Tense, emotionally intense, and ultimately hopeful in measured doses; the show alternates between harrowing, claustrophobic moments inside prison and triumphant legal breakthroughs. Viewers can expect moral urgency, frustration at systemic injustice, and catharsis when the protagonist makes progress, all carried by grounded, empathetic performances."
