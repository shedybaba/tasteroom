# Copy to .env and fill in. Never commit .env.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6.1-sol
APP_ENV=development
RATE_LIMIT_PLAN=5/hour
RATE_LIMIT_SUGGEST=60/minute
RATE_LIMIT_ROOMS=10/hour
RATE_LIMIT_JOIN=60/hour
RATE_LIMIT_ROOM_READ=60/minute
# SQLite for invite rooms (mount a volume here in production). Default: ./data locally, /data in Docker.
DATA_DIR=
AGENT_DISABLED=0
